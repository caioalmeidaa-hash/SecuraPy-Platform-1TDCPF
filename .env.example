# Copie para .env e TROQUE os valores. O .env nunca vai para o Git.

# Bancos (use só letras, números e hífen nas senhas: elas vão dentro da URI do MongoDB)
MONGO_ROOT_USER=securapy
MONGO_ROOT_PASSWORD=troque-esta-senha-mongo
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=securapy
MYSQL_USER=securapy
MYSQL_PASSWORD=troque-esta-senha-mysql

# Segredos da aplicação (mínimo 32 caracteres) — gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
FLASK_SECRET_KEY=gere-outro-segredo-aleatorio-com-pelo-menos-32-caracteres

# Operador administrador criado na primeira subida (senha: 8+ caracteres, letras e números)
ADMIN_EMAIL=admin@cybershield.com
ADMIN_SENHA=TroqueEsta123

# LLM (opcional). Sem chave → modo mock (regras), mesma interface.
OPENAI_API_KEY=
LLM_MODELO=gpt-4o-mini
LLM_MODO=auto

# Enriquecimento (opcional)
IPINFO_TOKEN=
ENRIQUECIMENTO_OFFLINE=0

# Retenção de eventos no MongoDB em dias (0 = sem TTL)
EVENTOS_TTL_DIAS=0

# Gemini (opcional). Com chave, o assistente usa o Gemini.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite

# Alertas no celular (Telegram) — veja a página Conectar no painel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Endereço do painel usado nos links das mensagens
SECURAPY_URL_PUBLICA=http://localhost:5000
